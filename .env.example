# Copy to .env for local overrides. On Render these live in the
# envVars block of render.yaml instead — see README "Deploy".

# Port the API listens on (Render sets this automatically)
PORT=3001

# Where the SQLite file lives. Point this at a mounted disk in production.
# Render example: /var/data  (must match render.yaml disk.mountPath)
DATA_DIR=./data

NODE_ENV=production

# Load 64 demo trades on first run when the database is empty.
# Set to false for a real journal.
VITE_SEED_DEMO=true
